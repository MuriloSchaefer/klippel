{
  "name": "Klippel",
  "version": "2.4.2",
  "author": "Murilo Francisco Schaefer",
  "description": "Uma aplicação para fazer o geerenciamento de orçamentos em roupas",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/electron/main/index.js",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@helia/mfs": "^7.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/lab": "^9.0.0-beta.2",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.0.2",
    "@mui/x-tree-view": "^9.0.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@use-gesture/react": "^10.3.1",
    "babel-plugin-direct-import": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "blockstore-fs": "^3.0.3",
    "d3": "^7.9.0",
    "datastore-fs": "^11.0.4",
    "dompurify": "^3.4.9",
    "electron-ollama": "^0.1.25",
    "electron-squirrel-startup": "^1.0.1",
    "glob": "^13.0.6",
    "helia": "^6.1.4",
    "install-peerdeps": "^3.0.7",
    "jazz-tools": "^0.19.0",
    "jse-eval": "^1.5.2",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.5",
    "proper-lockfile": "^4.1.2",
    "puppeteer-core": "^22.15.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-dynamic-middlewares": "^2.2.0",
    "remark-gfm": "^4.0.1",
    "reselect": "^5.1.1",
    "styled-components": "^6.4.1",
    "toad-scheduler": "^3.1.0",
    "tslib": "^2.8.1",
    "update-electron-app": "^3.1.2",
    "ws": "^8.20.1"
  },
  "resolutions": {
    "styled-components": "^5.3.3"
  },
  "scripts": {
    "start": "electron-vite preview --mode development",
    "dev": "electron-vite dev --watch --mode development --sourcemap",
    "jazz:sync": "jazz-run sync --in-memory --host 127.0.0.1 --port ${KLIPPEL_JAZZ_SYNC_PORT:-4242}",
    "prebuild": "electron-vite build",
    "package": "electron-vite build && electron-forge package",
    "make": "electron-vite build && electron-forge make",
    "publish": "electron-forge publish",
    "package:tests": "node scripts/build-test-bundle.mjs",
    "test:e2e": "unset ELECTRON_RUN_AS_NODE; ENV_NAME=\"${ENV_NAME:-benchmark}\" BASE_WORKSPACE=\"${BASE_WORKSPACE:-empty}\" KLIPPEL_DEV_LOG=1 jest",
    "test:e2e:headless": "unset ELECTRON_RUN_AS_NODE; ENV_NAME=\"${ENV_NAME:-benchmark}\" BASE_WORKSPACE=\"${BASE_WORKSPACE:-empty}\" KLIPPEL_DEV_LOG=1 KLIPPEL_USE_XVFB=1 jest",
    "test:e2e:collaborative": "npm run prebuild && unset ELECTRON_RUN_AS_NODE; KLIPPEL_E2E_SKIP_GLOBAL_SETUP=1 KLIPPEL_DEV_LOG=1 jest --testPathPatterns tests/collaborative/",
    "test:e2e:collaborative:headless": "npm run prebuild && unset ELECTRON_RUN_AS_NODE; KLIPPEL_E2E_SKIP_GLOBAL_SETUP=1 KLIPPEL_USE_XVFB=1 xvfb-run -a --server-args=\"-screen 0 1280x1024x24\" jest --testPathPatterns tests/collaborative/",
    "test:e2e:perf": "unset ELECTRON_RUN_AS_NODE; ENV_NAME=\"${ENV_NAME:-benchmark}\" BASE_WORKSPACE=\"${BASE_WORKSPACE:-empty}\" KLIPPEL_DEV_LOG=1 jest --testPathPatterns tests/standalone/performance/",
    "test:e2e:perf:headless": "unset ELECTRON_RUN_AS_NODE; ENV_NAME=\"${ENV_NAME:-benchmark}\" BASE_WORKSPACE=\"${BASE_WORKSPACE:-empty}\" KLIPPEL_DEV_LOG=1 KLIPPEL_USE_XVFB=1 jest --testPathPatterns tests/standalone/performance/",
    "test:e2e:collaborative:perf": "npm run prebuild && unset ELECTRON_RUN_AS_NODE; KLIPPEL_E2E_SKIP_GLOBAL_SETUP=1 KLIPPEL_DEV_LOG=1 jest --testPathPatterns tests/collaborative/performance/",
    "test:e2e:collaborative:perf:headless": "npm run prebuild && unset ELECTRON_RUN_AS_NODE; KLIPPEL_E2E_SKIP_GLOBAL_SETUP=1 KLIPPEL_USE_XVFB=1 jest --testPathPatterns tests/collaborative/performance/",
    "rebuild:native": "node -e \"require('@electron/rebuild').rebuild({buildPath:process.cwd(),electronVersion:require('./node_modules/electron/package.json').version,onlyModules:['better-sqlite3'],force:true}).then(()=>console.log('done')).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "repository": {
    "url": "git@github.com:MuriloSchaefer/klippel.git"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@jest/globals": "^30.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/jsonld": "^1.5.15",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.34",
    "@types/react-test-renderer": "^19.1.0",
    "@types/styled-components": "^5.1.36",
    "@types/svg-parser": "^2.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "babel-jest": "^30.3.0",
    "electron": "^41.3.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.5",
    "gh-pages": "^6.3.0",
    "install": "^0.13.0",
    "jazz-run": "^0.19.22",
    "jest": "^30.3.0",
    "module-alias": "^2.3.4",
    "npm": "^11.13.0",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.2.5",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "xlsx": "^0.18.5"
  },
  "paths": {
    "@": [
      "./src/*"
    ],
    "@kernel": [
      "./src/kernel/*"
    ],
    "@system": [
      "./src/system/*"
    ]
  }
}
