{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": true
    },
    "target": "es2022",
    "transform": {
      "react": { "runtime": "automatic" }
    },
    "baseUrl": "./src",
    "paths": {
      "@kernel/*": ["kernel/*"],
      "@system/*": ["system/*"],
      "@helpers/*": ["helpers/*"]
    }
  },
  "module": { "type": "es6" },
  "sourceMaps": "inline"
}
