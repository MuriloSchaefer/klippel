{
  "version": "2.0.0",
  "tasks": [
    // Per-peer Chromium-profile wipe. Only `/tmp/klippel-<env>` (the
    // Chromium user-data dir set as `KLIPPEL_USER_DATA_DIR` in
    // launch.json) is removed so each run starts with a clean
    // renderer/devtools state. The Jazz workspace data under
    // `~/klippel/envs/<ENV_NAME>` is intentionally *not* wiped — the
    // SQLite store there must survive across debugger restarts so the
    // previous session's catalog/model edits persist.
    {
      "label": "klippel:reset-peer-A",
      "type": "shell",
      "command": "rm -rf /tmp/klippel-${input:peerAEnv}",
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "klippel:reset-peer-B",
      "type": "shell",
      "command": "rm -rf /tmp/klippel-${input:peerBEnv}",
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "klippel:wait-for-vite-dev",
      "type": "shell",
      "command": "until curl -sf -o /dev/null --max-time 1 http://localhost:5173/; do sleep 0.5; done",
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "klippel:prepare-peer-B-hmr",
      "dependsOrder": "sequence",
      "dependsOn": ["klippel:reset-peer-B", "klippel:wait-for-vite-dev"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "peerAEnv",
      "type": "promptString",
      "description": "Peer A — ENV_NAME",
      "default": "peerA"
    },
    {
      "id": "peerBEnv",
      "type": "promptString",
      "description": "Peer B — ENV_NAME",
      "default": "peerB"
    }
  ]
}
