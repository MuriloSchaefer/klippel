{
  "mcpServers": {
    "klippel": {
      "command": "npx",
      "args": [
        "tsx",
        "webapp/electron/main/mcp/server.ts"
      ],
      "env": {
        "CDP_PORT": "9222",
        "TSX_TSCONFIG_PATH": "webapp/tsconfig.json"
      }
    },
    "mui-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mui/mcp@latest"]
    },
    "electron-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    }
  }
}