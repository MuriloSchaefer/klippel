{
  "mcpServers": {
    "klippel": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "export PATH=/home/schaefer/.nvm/versions/node/v24.15.0/bin:$PATH; exec npx tsx /home/schaefer/Documents/personal/klippel/webapp/electron/main/mcp/server.ts"
      ],
      "env": {
        "CDP_PORT": "9222",
        "TSX_TSCONFIG_PATH": "/home/schaefer/Documents/personal/klippel/webapp/tsconfig.json"
      }
    },
    "mui-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mui/mcp@latest"]
    },
    "electron-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    }
  }
}